## Router Implementation

```python
# file: intent_router.py

from typing import Optional, Dict, List
from intent_classifier import CentralIntentClassifier, IntentResult, Intent
from workflow_base import WorkflowHandler

class IntentRouter:
    """Routes messages to appropriate workflow handlers."""
    
    def __init__(self):
        self.classifier = CentralIntentClassifier()
        self.handlers: List[WorkflowHandler] = []
    
    def register_handler(self, handler: WorkflowHandler):
        """Register a workflow handler."""
        self.handlers.append(handler)
    
    def route(self, message: str, state: Dict) -> Optional[str]:
        """
        Main routing method. Called from chat() endpoint.
        
        Args:
            message: Raw user message
            state: Current application state (globals as dict)
        
        Returns:
            Response string if a handler handles it, None to use LLM
        """
        
        message_lower = message.lower()
        
        # SINGLE CLASSIFICATION PASS
        intent_result = self.classifier.classify(message, state)
        
        # Route to appropriate handler
        for handler in self.handlers:
            if handler.can_handle(intent_result):
                response = handler.handle(message, message_lower, intent_result)
                if response is not None or handler.consumed():
                    return response
        
        # No handler claimed it; fall through to LLM
        return None
    
    def consumed(self) -> bool:
        """Did the last handler consume the message (even if no response)?"""
        # Used to distinguish "no response, ask LLM" from "handler handled it, no response needed"
        pass
```

