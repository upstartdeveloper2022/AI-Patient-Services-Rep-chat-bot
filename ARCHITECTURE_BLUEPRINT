## Centralized Intent Classifier Implementation

```python
# file: intent_classifier.py (continued)

import re
from typing import Optional, Tuple

class CentralIntentClassifier:
    """
    Single source of truth for intent detection.
    Runs once per message; all workflow decisions based on this result.
    """
    
    def __init__(self):
        # Load pre-computed decision trees / ML models here if desired
        pass
    
    def classify(self, message: str, context: Dict) -> IntentResult:
        """
        Classify a message to its primary intent.
        
        Args:
            message: The user's raw message
            context: Current state dict from appbeforeclaude9272026.py (globals converted to dict)
                    {
                        'pre_chart_complete': bool,
                        'patient_first_name': str | None,
                        'patient_last_name': str | None,
                        'dob_collected': bool,
                        'pcp_collected': bool,
                        'hipaa_status_determined': bool,
                        'new_patient_flow_active': bool,
                        'acute_existing_appt_day': str | None,
                        'acute_existing_appt_time': str | None,
                        'contagious_visit_active': bool,
                        ... other state flags
                    }
        
        Returns:
            IntentResult with primary_intent, confidence, secondary_intents, context dict
        """
        
        msg_lower = message.lower()
        detected_intents = {}  # {intent: confidence}
        context_dict = {}
        
        # ─────────────────────────────────────────────────────────────
        # HIGHEST PRIORITY: Life safety
        # ─────────────────────────────────────────────────────────────
        
        if self._detect_urgent_symptoms(msg_lower):
            detected_intents[Intent.URGENT_SYMPTOMS] = 0.99
        
        if self._detect_medical_professional(msg_lower):
            detected_intents[Intent.MEDICAL_PROFESSIONAL_CALL] = 0.95
        
        # ─────────────────────────────────────────────────────────────
        # HIGH PRIORITY: Pre-chart / HIPAA / Consent
        # ─────────────────────────────────────────────────────────────
        
        if not context.get('pre_chart_complete'):
            prechart_score = self._score_prechart_intent(message, context)
            if prechart_score > 0.5:
                detected_intents[Intent.PRE_CHART_COLLECTION] = prechart_score
        
        if (context.get('dob_collected') and context.get('pcp_collected') 
                and context.get('third_party_detected')
                and not context.get('hipaa_status_determined')):
            detected_intents[Intent.HIPAA_VERIFICATION] = 0.9
        
        if self._detect_spouse_consent_workflow(msg_lower, context):
            detected_intents[Intent.SPOUSE_CONSENT] = 0.85
        
        # ─────────────────────────────────────────────────────────────
        # MEDIUM PRIORITY: Existing workflows
        # ─────────────────────────────────────────────────────────────
        
        if context.get('acute_existing_appt_day'):
            reschedule_score = self._score_reschedule_intent(msg_lower)
            cancel_score = self._score_cancel_intent(msg_lower)
            
            if reschedule_score > 0.7:
                detected_intents[Intent.RESCHEDULE_APPOINTMENT] = reschedule_score
            if cancel_score > 0.7:
                detected_intents[Intent.CANCEL_APPOINTMENT] = cancel_score
        
        if context.get('contagious_visit_active'):
            detected_intents[Intent.ACUTE_CONTAGIOUS] = 0.8
        
        # ─────────────────────────────────────────────────────────────
        # NEW WORKFLOWS
        # ─────────────────────────────────────────────────────────────
        
        phf_score = self._score_phf_intent(msg_lower)
        if phf_score > 0.6:
            detected_intents[Intent.POST_HOSPITAL_FOLLOWUP] = phf_score
        
        if context.get('new_patient_flow_active'):
            detected_intents[Intent.NEW_PATIENT_SETUP] = 0.8
        
        # ─────────────────────────────────────────────────────────────
        # FALLBACK: General inquiries
        # ─────────────────────────────────────────────────────────────
        
        if self._detect_lab_work(msg_lower):
            detected_intents[Intent.LAB_WORK_INQUIRY] = 0.7
        
        if self._detect_medication_inquiry(msg_lower):
            detected_intents[Intent.MEDICATION_INQUIRY] = 0.7
        
        # Default fallback
        if not detected_intents:
            detected_intents[Intent.GENERAL_INQUIRY] = 0.5
        
        # ─────────────────────────────────────────────────────────────
        # SELECT PRIMARY INTENT BY PRIORITY
        # ─────────────────────────────────────────────────────────────
        
        primary_intent = min(
            detected_intents.keys(),
            key=lambda i: INTENT_PRIORITY.get(i, 999)
        )
        
        secondary_intents = [
            intent for intent in detected_intents
            if intent != primary_intent
        ]
        
        confidence = detected_intents[primary_intent]
        
        return IntentResult(
            primary_intent=primary_intent,
            confidence=confidence,
            secondary_intents=secondary_intents,
            context=context_dict,
            reason=f"Selected {primary_intent.value} with confidence {confidence:.2f}"
        )
    
    # ─────────────────────────────────────────────────────────────
    # Detection helper methods
    # ─────────────────────────────────────────────────────────────
    
    def _detect_urgent_symptoms(self, msg_lower: str) -> bool:
        """Detect life-threatening symptoms."""
        urgent_triggers = [
            "chest pain", "can't breathe", "difficulty breathing",
            "stroke", "unconscious", "seizure", "bleeding",
            "heart attack", "anaphylaxis"
        ]
        return any(trigger in msg_lower for trigger in urgent_triggers)
    
    def _detect_medical_professional(self, msg_lower: str) -> bool:
        """Detect if caller is a medical professional."""
        med_pro_triggers = [
            "this is the pharmacy", "calling from the hospital",
            "medical center", "specialist", "office manager",
            "this is dr.", "calling from dr."
        ]
        return any(trigger in msg_lower for trigger in med_pro_triggers)
    
    def _score_prechart_intent(self, message: str, context: Dict) -> float:
        """Score how much this message is pre-chart collection."""
        if context.get('pre_chart_complete'):
            return 0.0
        
        # If we've already asked for something and they're answering, score high
        score = 0.3  # baseline
        
        # Names, DOB, PCP are pre-chart indicators
        if re.search(r'\b[A-Z][a-z]+\s+[A-Z][a-z]+\b', message):
            score += 0.2  # Looks like a name
        if re.search(r'\d{1,2}/\d{1,2}/\d{2,4}|\b(january|february|march|april|may|june|july|august|september|october|november|december)\b', message.lower()):
            score += 0.2  # Looks like a date
        if re.search(r'\bdr\.\s+[a-z]+\b|patient of', message.lower()):
            score += 0.2  # Provider mention
        
        return min(score, 1.0)
    
    def _score_reschedule_intent(self, msg_lower: str) -> float:
        """Score reschedule intent."""
        reschedule_phrases = [
            "reschedule", "change", "move", "different time",
            "other day", "can't make it", "can't come", "i'd rather",
            "would prefer", "different appointment"
        ]
        return sum(1 for phrase in reschedule_phrases if phrase in msg_lower) * 0.2
    
    def _score_cancel_intent(self, msg_lower: str) -> float:
        """Score cancel intent."""
        cancel_phrases = [
            "cancel", "don't want", "don't need", "no longer",
            "nevermind", "forget it", "scratch that"
        ]
        return sum(1 for phrase in cancel_phrases if phrase in msg_lower) * 0.25
    
    def _score_phf_intent(self, msg_lower: str) -> float:
        """Score post-hospital follow-up intent."""
        phf_phrases = [
            "post hospital", "post-hospital", "hospital follow", "hospitalized",
            "discharged", "hospital stay", "follow-up appointment"
        ]
        return sum(1 for phrase in phf_phrases if phrase in msg_lower) * 0.3
    
    def _detect_spouse_consent_workflow(self, msg_lower: str, context: Dict) -> bool:
        """Detect if this is a spouse consent workflow."""
        spouse_phrases = [
            "my husband", "my wife", "my spouse", "spouse", "partner"
        ]
        return (any(phrase in msg_lower for phrase in spouse_phrases) 
                and context.get('third_party_detected')
                and context.get('patient_first_name'))
    
    def _detect_lab_work(self, msg_lower: str) -> bool:
        """Detect lab work inquiries."""
        lab_triggers = [
            "lab", "lab work", "lab results", "blood work", "test results",
            "labs", "bloodwork"
        ]
        return any(trigger in msg_lower for trigger in lab_triggers)
    
    def _detect_medication_inquiry(self, msg_lower: str) -> bool:
        """Detect medication inquiries."""
        med_triggers = [
            "medication", "medicine", "prescribed", "prescription",
            "metformin", "lisinopril", "what is it for"
        ]
        return any(trigger in msg_lower for trigger in med_triggers)
