    LAB_WORK_INQUIRY = "lab_work_inquiry"                # Priority: 60
    MEDICATION_INQUIRY = "medication_inquiry"             # Priority: 60


class IntentResult(NamedTuple):
    """Result of intent classification."""
    primary_intent: Intent
    confidence: float  # 0.0 - 1.0
    secondary_intents: List[Intent]  # Can co-occur, but don't route
