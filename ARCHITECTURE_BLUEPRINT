## Workflow Handler Interface

Each workflow becomes a class implementing this interface:

```python
# file: workflow_base.py

from abc import ABC, abstractmethod
from typing import Optional, Dict
from intent_classifier import IntentResult

class WorkflowHandler(ABC):
    """Base class for all workflow handlers."""
    
    def __init__(self, state: Dict):
        """
        Args:
            state: Global state dict (replaces global variables)
        """
        self.state = state
    
    @abstractmethod
    def can_handle(self, intent_result: IntentResult) -> bool:
        """
        Check if this handler owns the intent.
        
        Returns:
            True if this handler should be called, False otherwise
        """
        pass
    
    @abstractmethod
    def handle(self, message: str, message_lower: str, 
              intent_result: IntentResult) -> Optional[str]:
        """
        Process the message and return a response, or None if no response.
        
        Args:
            message: Raw user message
            message_lower: Lowercase version
            intent_result: Classification result
        
        Returns:
            Response string, or None to fall through to LLM
        """
        pass
    
    def update_state(self):
        """Update global state dict after handling. Called automatically."""
        pass


# Example: Reschedule Handler
class RescheduleHandler(WorkflowHandler):
    
    def can_handle(self, intent_result: IntentResult) -> bool:
        return intent_result.primary_intent == Intent.RESCHEDULE_APPOINTMENT
    
    def handle(self, message: str, message_lower: str, 
              intent_result: IntentResult) -> Optional[str]:
        """
        This handler now owns the entire reschedule workflow.
        No other handler can interfere.
        """
        # All reschedule logic here
